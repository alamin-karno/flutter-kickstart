import 'package:dartz/dartz.dart' show Either, Left;
import 'package:dio/dio.dart';
import 'package:{{package}}/core/network/app_api_client.dart';
import 'package:{{package}}/core/network/app_failure.dart';
import 'package:{{package}}/core/network/dio_factory.dart';
import 'package:{{package}}/core/network/viva_failure_converter.dart';
import 'package:viva_network_kit/viva_network_kit.dart';

/// [AppApiClient] built on `viva_network_kit`'s `DioNetworkCallExecutor`.
class VivaApiClient implements AppApiClient {
  VivaApiClient(this._executor);

  /// Builds the `Dio` instance and executor in one step.
  factory VivaApiClient.create({
    required String baseUrl,
    required JsonSerializer serializer,
    required Duration timeout,
    List<Interceptor> interceptors = const [],
  }) {
    return VivaApiClient(
      DioNetworkCallExecutor(
        dio: createDio(
          baseUrl: baseUrl,
          timeout: timeout,
          interceptors: interceptors,
        ),
        dioSerializer: serializer,
        errorConverter: const VivaFailureConverter(),
      ),
    );
  }

  final DioNetworkCallExecutor _executor;

  @override
  Future<Either<AppFailure, T>> get<T>(
    String path, {
    Map<String, dynamic>? queryParameters,
  }) => _guard(
    () => _executor.get<AppFailure, T, T>(
      path,
      queryParameters: queryParameters,
    ),
  );

  @override
  Future<Either<AppFailure, List<T>>> getList<T>(
    String path, {
    Map<String, dynamic>? queryParameters,
  }) => _guard(
    () => _executor.get<AppFailure, List<T>, T>(
      path,
      queryParameters: queryParameters,
    ),
  );

  @override
  Future<Either<AppFailure, T>> post<T>(
    String path, {
    Object? body,
    Map<String, dynamic>? queryParameters,
  }) => _guard(
    () => _executor.post<AppFailure, T, T>(
      path,
      body: body,
      queryParameters: queryParameters,
    ),
  );

  @override
  Future<Either<AppFailure, T>> put<T>(
    String path, {
    Map<String, dynamic>? body,
    Map<String, dynamic>? queryParameters,
  }) => _guard(
    () => _executor.put<AppFailure, T, T>(
      path,
      body: body,
      queryParameters: queryParameters,
    ),
  );

  @override
  Future<Either<AppFailure, T>> patch<T>(
    String path, {
    Map<String, dynamic>? body,
    Map<String, dynamic>? queryParameters,
  }) => _guard(
    () => _executor.patch<AppFailure, T, T>(
      path,
      body: body,
      queryParameters: queryParameters,
    ),
  );

  @override
  Future<Either<AppFailure, T>> delete<T>(
    String path, {
    Map<String, dynamic>? body,
    Map<String, dynamic>? queryParameters,
  }) => _guard(
    () => _executor.delete<AppFailure, T, T>(
      path,
      body: body,
      queryParameters: queryParameters,
    ),
  );

  /// `viva_network_kit` only catches `Exception`s. A missing parser or a
  /// changed JSON shape throws a `TypeError` instead, which would otherwise
  /// escape the data layer, so it is turned into a [ParsingFailure] here.
  Future<Either<AppFailure, R>> _guard<R>(
    Future<Either<AppFailure, R>> Function() call,
  ) async {
    try {
      return await call();
    // ignore: avoid_catching_errors, decoding bugs must not cross layers.
    } on TypeError {
      return const Left(ParsingFailure());
    }
  }
}
