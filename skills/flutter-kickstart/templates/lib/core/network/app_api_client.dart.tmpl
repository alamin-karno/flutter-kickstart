import 'package:dartz/dartz.dart' show Either;
import 'package:{{package}}/core/network/app_failure.dart';

/// The only door to the network for feature code.
///
/// Features depend on [AppApiClient], never on the HTTP package behind it,
/// so the transport stays swappable and every call is mockable. The one
/// implementation is chosen at scaffold time and wired in `lib/core/di/`.
/// `Either` is `dartz`'s; don't mix in `fpdart`.
///
/// Every model decoded through this client needs a parser registered once
/// in DI: `serializer.addParser<OrderModel>(OrderModel.fromJson)`. Request
/// bodies that are models implement `Serializable` (`toJson()`).
abstract interface class AppApiClient {
  /// GET returning one decoded [T].
  Future<Either<AppFailure, T>> get<T>(
    String path, {
    Map<String, dynamic>? queryParameters,
  });

  /// GET returning a list, each element decoded as [T].
  Future<Either<AppFailure, List<T>>> getList<T>(
    String path, {
    Map<String, dynamic>? queryParameters,
  });

  Future<Either<AppFailure, T>> post<T>(
    String path, {
    Object? body,
    Map<String, dynamic>? queryParameters,
  });

  Future<Either<AppFailure, T>> put<T>(
    String path, {
    Map<String, dynamic>? body,
    Map<String, dynamic>? queryParameters,
  });

  Future<Either<AppFailure, T>> patch<T>(
    String path, {
    Map<String, dynamic>? body,
    Map<String, dynamic>? queryParameters,
  });

  Future<Either<AppFailure, T>> delete<T>(
    String path, {
    Map<String, dynamic>? body,
    Map<String, dynamic>? queryParameters,
  });
}
