import 'package:dio/dio.dart';
import 'package:{{package}}/core/network/app_failure.dart';

/// Turns transport exceptions into [AppFailure]s. The only place that knows
/// what a `DioException` means; every `AppApiClient` implementation
/// delegates here, so all of them map errors the same way.
class AppFailureConverter {
  const AppFailureConverter();

  AppFailure convert(Exception exception) {
    return switch (exception) {
      DioException() => _fromDioException(exception),
      FormatException() => const ParsingFailure(),
      _ => const UnknownFailure(),
    };
  }

  AppFailure _fromDioException(DioException e) {
    if (e.type == DioExceptionType.badResponse) {
      final statusCode = e.response?.statusCode;
      if (statusCode == 401) return const UnauthorizedFailure();
      return ServerFailure(statusCode);
    }
    if (e.type == DioExceptionType.cancel) {
      return const UnknownFailure('Request was cancelled.');
    }
    // connectionError and every timeout type (the set grows across dio
    // versions, e.g. transformTimeout), so match by name.
    if (e.type == DioExceptionType.connectionError ||
        e.type.name.toLowerCase().contains('timeout')) {
      return const NetworkFailure();
    }
    return const UnknownFailure();
  }
}
