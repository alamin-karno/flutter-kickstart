/// Wraps the crash-reporting SDK so feature code and the entrypoints never
/// import it directly. The concrete adapter lives next to this file.
abstract interface class CrashReporter {
  Future<void> init();
  Future<void> recordError(
    Object error,
    StackTrace? stackTrace, {
    bool fatal = false,
  });
  void log(String message);
  void setUserContext({String? id, Map<String, String>? extra});
}
