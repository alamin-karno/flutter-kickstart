/// Maps a route name to its screen. Passed to `MaterialApp.onGenerateRoute`.
/// Feature routes are added at the `scaffold:routes` marker (the scaffold's
/// `add_feature.py` does this). Unknown names return null, which lets
/// `onUnknownRoute` handle them.
Route<dynamic>? onGenerateAppRoute(RouteSettings settings) {
  final screen = switch (settings.name) {
    // scaffold:routes
    _ => null,
  };
  if (screen == null) return null;
  return MaterialPageRoute<void>(builder: (_) => screen, settings: settings);
}
