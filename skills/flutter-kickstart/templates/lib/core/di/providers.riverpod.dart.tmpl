// One statement per parser keeps `add_feature.py` insertions format-proof.
// ignore_for_file: cascade_invocations

import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:{{package}}/core/config/app_config.dart';
import 'package:{{package}}/core/error_reporting/crash_reporter.dart';
import 'package:{{package}}/core/logging/app_logger.dart';
import 'package:{{package}}/core/network/api_interceptors.dart';
import 'package:{{package}}/core/network/app_api_client.dart';
{{api_client_import}}
import 'package:{{package}}/core/network/json_serializer.dart';
// scaffold:model-imports

/// The provider graph is the DI graph: no separate service locator.
///
/// [appConfigProvider], [crashReporterProvider] and [appLoggerProvider] are
/// overridden in `bootstrap.dart` with the instances built there.
final appConfigProvider = Provider<AppConfig>(
  (ref) => throw UnimplementedError('Overridden in bootstrap()'),
);

final crashReporterProvider = Provider<CrashReporter>(
  (ref) => throw UnimplementedError('Overridden in bootstrap()'),
);

final appLoggerProvider = Provider<AppLogger>(
  (ref) => throw UnimplementedError('Overridden in bootstrap()'),
);

/// One `addParser` per model decoded through [AppApiClient].
final jsonSerializerProvider = Provider<JsonSerializer>((ref) {
  final serializer = JsonSerializer();
  // scaffold:parsers
  return serializer;
});

final appApiClientProvider = Provider<AppApiClient>((ref) {
  final config = ref.watch(appConfigProvider);
  return {{api_client_class}}.create(
    baseUrl: config.apiBaseUrl,
    timeout: config.apiTimeout,
    serializer: ref.watch(jsonSerializerProvider),
    interceptors: [
      // Replace `() => null` with a read from secure storage once auth exists.
      AuthInterceptor(() => null),
      LoggingInterceptor(ref.watch(appLoggerProvider)),
    ],
  );
});
