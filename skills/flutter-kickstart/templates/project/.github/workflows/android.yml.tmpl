name: Android Build & Deploy

# Branch -> flavor mapping MUST match ios.yml and ios/fastlane/Fastfile
# (see the flutter-deployment skill).
on:
  push:
    branches: [develop, staging, main]
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build:
    name: Build & sign Android
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - uses: subosito/flutter-action@v2
        with:
          flutter-version: "{{flutter_version}}"
          channel: stable
          cache: true

      - name: Resolve flavor from branch
        id: flavor
        run: |
          case "${GITHUB_REF_NAME}" in
            develop) echo "flavor=development" >> "$GITHUB_OUTPUT" ;;
            staging) echo "flavor=staging" >> "$GITHUB_OUTPUT" ;;
            main)    echo "flavor=production" >> "$GITHUB_OUTPUT" ;;
            *) echo "No flavor mapped for branch $GITHUB_REF_NAME" >&2; exit 1 ;;
          esac

      - run: flutter pub get

      # android/app/build.gradle.kts reads these ANDROID_KEYSTORE_* variables.
      - name: Decode Android keystore
        run: |
          echo "${{ secrets.ANDROID_KEYSTORE_BASE64 }}" | base64 -d > "$RUNNER_TEMP/upload.jks"
          echo "ANDROID_KEYSTORE_PATH=$RUNNER_TEMP/upload.jks" >> "$GITHUB_ENV"

      - name: Build App Bundle
        run: >
          flutter build appbundle
          --flavor ${{ steps.flavor.outputs.flavor }}
          --target lib/main_${{ steps.flavor.outputs.flavor }}.dart
          --obfuscate --split-debug-info=build/symbols
          --dart-define=API_BASE_URL=${{ secrets.API_BASE_URL }}
          --dart-define=SENTRY_DSN=${{ secrets.SENTRY_DSN }}
        env:
          ANDROID_KEYSTORE_ALIAS: ${{ secrets.ANDROID_KEYSTORE_ALIAS }}
          ANDROID_KEYSTORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
          ANDROID_KEYSTORE_PRIVATE_KEY_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PRIVATE_KEY_PASSWORD }}

      - name: Upload debug symbols
        if: steps.flavor.outputs.flavor == 'production'
        run: ./scripts/upload_symbols.sh build/symbols
        env:
          SENTRY_AUTH_TOKEN: ${{ secrets.SENTRY_AUTH_TOKEN }}
          FIREBASE_TOKEN: ${{ secrets.FIREBASE_TOKEN }}
          FIREBASE_APP_ID: ${{ secrets.FIREBASE_APP_ID_ANDROID }}

      - name: Distribute to Firebase App Distribution
        if: steps.flavor.outputs.flavor != 'production'
        uses: wzieba/Firebase-Distribution-Github-Action@v1
        with:
          appId: ${{ secrets.FIREBASE_APP_ID_ANDROID }}
          serviceCredentialsFileContent: ${{ secrets.FIREBASE_SERVICE_ACCOUNT }}
          file: build/app/outputs/bundle/${{ steps.flavor.outputs.flavor }}Release/app-${{ steps.flavor.outputs.flavor }}-release.aab
          groups: testers

      - name: Upload to Play Store (internal track)
        if: steps.flavor.outputs.flavor == 'production'
        uses: r0adkll/upload-google-play@v1
        with:
          serviceAccountJsonPlainText: ${{ secrets.PLAY_STORE_SERVICE_ACCOUNT_JSON }}
          packageName: {{android_id}}
          releaseFiles: build/app/outputs/bundle/productionRelease/app-production-release.aab
          track: internal # promote to production by hand until the team agrees on auto-promotion
