#!/usr/bin/env bash
# Same checks as .github/workflows/pr_checks.yml. Run before pushing.
set -euo pipefail
cd "$(dirname "$0")/.."

FLUTTER="flutter"
DART="dart"
if [[ -f .fvmrc ]] && command -v fvm >/dev/null 2>&1; then
  FLUTTER="fvm flutter"
  DART="fvm dart"
fi

$DART format --output=none --set-exit-if-changed lib test
$FLUTTER analyze
$FLUTTER test --coverage --test-randomize-ordering-seed random

echo "Quality gate passed."
