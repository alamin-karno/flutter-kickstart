default_platform(:ios)

# Bundle id per flavor, read from ios/Runner.xcodeproj when the project was
# scaffolded. Keep in sync if you change a bundle id in Xcode.
IDS = {
  "development" => "{{ios_id}}.dev",
  "staging" => "{{ios_id}}.stg",
  "production" => "{{ios_id}}",
}.freeze

# Imports the signing certificate and profile from CI secrets into a temporary
# keychain. If the team standardizes on `match`, replace this block with
# `match(type: "appstore", readonly: true)` and drop the cert/profile secrets.
before_all do
  next unless ENV["CI"]

  create_keychain(
    name: "ci_keychain",
    password: ENV["KEYCHAIN_PASSWORD"] || "ci-keychain",
    default_keychain: true,
    unlock: true,
    timeout: 3600,
  )
  import_certificate(
    certificate_path: decode_secret_to_tmp("IOS_CERTIFICATE_BASE64", ".p12"),
    certificate_password: ENV["IOS_CERTIFICATE_PASSWORD"],
    keychain_name: "ci_keychain",
    keychain_password: ENV["KEYCHAIN_PASSWORD"] || "ci-keychain",
  )
  install_provisioning_profile(
    path: decode_secret_to_tmp("IOS_PROVISIONING_PROFILE_BASE64", ".mobileprovision"),
  )
end

def decode_secret_to_tmp(env_var, extension)
  require "base64"
  require "tmpdir"
  path = File.join(Dir.tmpdir, "#{env_var}#{extension}")
  File.binwrite(path, Base64.decode64(ENV.fetch(env_var)))
  path
end

def api_key
  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
    key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
  )
end

# Run `flutter build ios --config-only --flavor <flavor> ...` first (ios.yml does).
def archive(flavor)
  build_app(
    workspace: "Runner.xcworkspace",
    scheme: flavor,
    configuration: "Release-#{flavor}",
    export_method: "app-store",
    export_options: { provisioningProfiles: { IDS.fetch(flavor) => ENV["IOS_PROVISIONING_PROFILE_NAME"] }.compact },
  )
end

platform :ios do
  desc "Build a flavor and upload it to TestFlight"
  lane :beta do |options|
    flavor = options[:flavor] || "staging"
    archive(flavor)
    upload_to_testflight(api_key: api_key, app_identifier: IDS.fetch(flavor), skip_waiting_for_build_processing: true)
  end

  desc "Build production and upload it to App Store Connect (not submitted)"
  lane :release do |options|
    flavor = options[:flavor] || "production"
    archive(flavor)
    upload_to_app_store(
      api_key: api_key,
      app_identifier: IDS.fetch(flavor),
      submit_for_review: false,
      automatic_release: false,
      skip_screenshots: true,
      skip_metadata: true,
      precheck_include_in_app_purchases: false,
    )
  end
end
